{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // bundler e não nodenext: @casa/contracts é consumido também pelo Metro,
    // que não resolve `./x.js` para `x.ts`. Os imports internos da API seguem com
    // extensão `.js` — corretos para Node ESM se um dia sair do tsx.
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2023",
    "lib": ["es2023"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "worker", "drizzle.config.ts"]
}
