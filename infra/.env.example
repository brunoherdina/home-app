# Casa — variáveis do compose local (Épico 0a).
# Copie para infra/.env e preencha. O .env é gitignorado e NUNCA vai pro repo.
# Gerar uma senha: openssl rand -base64 24

# Superusuário de bootstrap. Usado só pelo initdb e por backup/restore —
# nem a API nem as migrations se conectam com ele.
POSTGRES_SUPERUSER=casa_admin
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_DB=casa
POSTGRES_PORT=5433 # 5432 costuma estar ocupado por outro projeto

# Role dono dos objetos. Só o drizzle-kit usa, em deploy de migration.
CASA_OWNER_PASSWORD=

# Role do pool da API: sem BYPASSRLS, sem ser owner (ADR-0002).
CASA_APP_PASSWORD=

# Montadas a partir das senhas acima; a API só recebe a de casa_app.
# DATABASE_URL=postgres://casa_app:<CASA_APP_PASSWORD>@localhost:5433/casa
# MIGRATION_DATABASE_URL=postgres://casa_owner:<CASA_OWNER_PASSWORD>@localhost:5433/casa
