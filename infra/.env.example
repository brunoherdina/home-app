# Casa — variáveis do compose local (Épico 0a).
# Copie para infra/.env e preencha. O .env é gitignorado e NUNCA vai pro repo.
# Gerar uma senha: openssl rand -base64 24

# Superusuário de bootstrap. Usado só pelo initdb e por backup/restore —
# nem a API nem as migrations se conectam com ele.
POSTGRES_SUPERUSER=casa_admin
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_DB=casa
POSTGRES_PORT=5433 # 5432 costuma estar ocupado por outro projeto

# Role dono dos objetos. Só o drizzle-kit usa, em deploy de migration.
CASA_OWNER_PASSWORD=

# Role do pool da API: sem BYPASSRLS, sem ser owner (ADR-0002).
CASA_APP_PASSWORD=

# Role do pool das rotas sem identidade — register/login/refresh (ADR-0013).
# Mesmas restrições do casa_app; o raio dele é o GRANT mínimo das migrations.
CASA_AUTH_PASSWORD=

# Montadas a partir das senhas acima. A API recebe SÓ as de casa_app e
# casa_auth; a de casa_owner existe apenas no ambiente de quem roda migration
# (drizzle-kit).
DATABASE_URL=postgres://casa_app:<CASA_APP_PASSWORD>@localhost:5433/casa
AUTH_DATABASE_URL=postgres://casa_auth:<CASA_AUTH_PASSWORD>@localhost:5433/casa
MIGRATION_DATABASE_URL=postgres://casa_owner:<CASA_OWNER_PASSWORD>@localhost:5433/casa

# Auth (ADR-0003 / ADR-0008). Gerar: openssl rand -base64 48
# Trocar o segredo invalida TODOS os tokens em circulação — inclusive os refresh
# de 60 dias no SecureStore. É o botão de "deslogar todo mundo".
JWT_SECRET=
# Access curto: é ele que define a janela de um token vazado. O refresh rotativo
# é o que evita que "curto" signifique logout a cada 15 minutos.
ACCESS_TTL_SEGUNDOS=900
REFRESH_TTL_DIAS=60

# API
PORT=3333
HOST=0.0.0.0 # device físico no WSL2 alcança pela rede, não por localhost
NODE_ENV=development
